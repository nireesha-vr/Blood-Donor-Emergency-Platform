<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fff5f5" />
      <stop offset="100%" stop-color="#ffe3e3" />
    </linearGradient>
    <linearGradient id="dropGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ff4d4d" />
      <stop offset="100%" stop-color="#b71c1c" />
    </linearGradient>
    <linearGradient id="heartGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#e63946" />
      <stop offset="100%" stop-color="#990000" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="10" stdDeviation="15" flood-color="#e63946" flood-opacity="0.2"/>
    </filter>
  </defs>

  <!-- Outer Card Background -->
  <rect width="800" height="600" rx="30" fill="url(#bgGrad)" />

  <!-- Abstract Pulse Waves -->
  <path d="M 50 300 Q 150 250, 250 300 T 450 300 T 650 300 T 750 300" fill="none" stroke="#ffccd5" stroke-width="4" stroke-dasharray="10 10"/>
  <path d="M 50 320 Q 200 400, 350 300 T 600 320 T 750 280" fill="none" stroke="#ffb3c1" stroke-width="6" opacity="0.6"/>

  <!-- Medical Cross Circle -->
  <circle cx="200" cy="180" r="45" fill="#ffffff" filter="url(#shadow)"/>
  <rect x="192" y="155" width="16" height="50" rx="4" fill="#e63946"/>
  <rect x="175" y="172" width="50" height="16" rx="4" fill="#e63946"/>

  <!-- Main Blood Drop Illustration -->
  <g filter="url(#shadow)">
    <path d="M 400 120 C 400 120, 560 330, 560 410 C 560 498, 488 570, 400 570 C 312 570, 240 498, 240 410 C 240 330, 400 120, 400 120 Z" fill="url(#dropGrad)"/>
    <!-- Highlight shine -->
    <path d="M 370 200 C 370 200, 310 350, 310 410 C 310 440, 325 470, 345 490 C 330 470, 320 440, 320 410 C 320 350, 370 200, 370 200 Z" fill="#ffffff" opacity="0.3"/>
  </g>

  <!-- Heart inside Blood Drop -->
  <path d="M 400 420 C 400 420, 360 380, 340 360 C 320 340, 320 310, 345 295 C 370 280, 395 300, 400 310 C 405 300, 430 280, 455 295 C 480 310, 480 340, 460 360 C 440 380, 400 420, 400 420 Z" fill="#ffffff" opacity="0.95"/>

  <!-- Hands Holding Drop Badge -->
  <g filter="url(#shadow)">
    <rect x="520" y="420" width="220" height="90" rx="20" fill="#ffffff"/>
    <circle cx="565" cy="465" r="25" fill="#2ec4b6"/>
    <path d="M 555 465 L 562 472 L 575 458" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    <text x="605" y="458" font-family="'Poppins', sans-serif" font-weight="700" font-size="18" fill="#1d3557">Save Lives</text>
    <text x="605" y="480" font-family="'Poppins', sans-serif" font-weight="500" font-size="14" fill="#6c757d">24/7 Verified</text>
  </g>

  <!-- Floating Decorative Particles -->
  <circle cx="150" cy="450" r="12" fill="#e63946" opacity="0.4"/>
  <circle cx="680" cy="180" r="18" fill="#ff9f1c" opacity="0.4"/>
  <circle cx="620" cy="100" r="8" fill="#2ec4b6" opacity="0.5"/>
</svg>
